<?xml version="1.0" encoding="utf-8"?>
<!-- MSI package for Disk Occupancy (WiX v5+ syntax).
     Version + payload dir are passed by build-release.ps1:
       wix build disk-occupancy.wxs -d Version=X.Y.Z -d PayloadDir=... -o out.msi
     MSI version fields must each be <= 65535; we pass Major.Minor.Build
     (3-part — build is epoch-minutes % 100000, always in range). -->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="Disk Occupancy" Manufacturer="Robin L. M. Cheung"
           Version="$(Version)" UpgradeCode="f2a81c4e-5b3d-4c7a-9e12-7d4f9a1b2c3d"
           Scope="perUser">
    <MajorUpgrade DowngradeErrorMessage="A newer version of Disk Occupancy is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="INSTALLFOLDER" Name="Disk Occupancy" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ShortcutDir" Name="Disk Occupancy" />
    </StandardDirectory>

    <Feature Id="Main" Title="Disk Occupancy" Level="1">
      <ComponentGroupRef Id="Payload" />
      <ComponentRef Id="Shortcuts" />
    </Feature>

    <ComponentGroup Id="Payload" Directory="INSTALLFOLDER">
      <Files Include="$(PayloadDir)\**" />
    </ComponentGroup>

    <Component Id="Shortcuts" Directory="ShortcutDir">
      <Shortcut Id="AppShortcut" Name="Disk Occupancy"
                Target="[INSTALLFOLDER]DiskOccupancy.exe"
                WorkingDirectory="INSTALLFOLDER" />
      <RegistryValue Root="HKCU" Key="Software\RobinsAI\DiskOccupancy"
                     Name="installed" Value="1" Type="integer" KeyPath="yes" />
    </Component>
  </Package>
</Wix>
